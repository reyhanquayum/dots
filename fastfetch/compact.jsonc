// Compact fastfetch profile for narrow terminals (< 104 columns).
// The logo sits above the modules, so the widest line stays under 60 columns.
// ~/.config/fish/config.fish picks this file when $COLUMNS is too small
// for ~/.config/fastfetch/config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "position": "top",
    "source": "$2           ▄ ▄                   \n       ▄   ▄▄▄     ▄ ▄▄▄ ▄ ▄     \n       █ ▄ █▄█ ▄▄▄ █ █▄█ █ █     \n    ▄▄ █▄█▄▄▄█ █▄█▄█▄▄█▄▄█ █     \n  ▄ █▄▄█ ▄ ▄▄ ▄█ ▄▄▄▄▄▄▄▄▄▄▄▄▄▄  \n  █▄▄▄▄ ▄▄▄ █ ▄ ▄▄▄ ▄ ▄▄▄ ▄ ▄ █ ▄\n▄ █ █▄█ █▄█ █ █ █▄█ █ █▄█ ▄▄▄ █ █\n█▄█ ▄ █▄▄█▄▄█ █ ▄▄█ █ ▄ █ █▄█▄█ █\n    █▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄█ █▄█▄▄▄█    ",
    "color": {
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "bottom": 1,
      "left": 0
    }
  },
  "display": {
    "color": {
      "keys": "blue",
      "title": "yellow"
    },
    "separator": "➜"
  },
  "modules": [
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "cyan",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "blue",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "packages",
      "key": " Pkgs",
      "keyColor": "cyan",
      "format": "{pacman} pacman · {nix-user} nix · {flatpak-all} flatpak · {appimage} appimage"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "blue",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "󰑭 Mem",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "cyan",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 8,
      "symbol": "circle",
      "block": {
        "width": 8
      }
    }
  ]
}
