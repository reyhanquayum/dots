{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$2           ▄ ▄                   \n       ▄   ▄▄▄     ▄ ▄▄▄ ▄ ▄     \n       █ ▄ █▄█ ▄▄▄ █ █▄█ █ █     \n    ▄▄ █▄█▄▄▄█ █▄█▄█▄▄█▄▄█ █     \n  ▄ █▄▄█ ▄ ▄▄ ▄█ ▄▄▄▄▄▄▄▄▄▄▄▄▄▄  \n  █▄▄▄▄ ▄▄▄ █ ▄ ▄▄▄ ▄ ▄▄▄ ▄ ▄ █ ▄\n▄ █ █▄█ █▄█ █ █ █▄█ █ █▄█ ▄▄▄ █ █\n█▄█ ▄ █▄▄█▄▄█ █ ▄▄█ █ ▄ █ █▄█▄█ █\n    █▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄█ █▄█▄▄▄█    ",
    "color": {
      "2": "blue"
    },
    "padding": {
      "top": 5,
      "bottom": 0,
      "left": 0
    }
  },
  "display": {
    "color": {
      "keys": "blue",
      "title": "yellow"
    },
    "separator": "➜"
  },
  "modules": [
    "break",
    {
      "type": "title",
      // adjust these leading spaces to center "reyhan@reyhan-z14"
      "format": "           {6}{7}{8}"
    },
    "break",
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────────┐"
    },
    "break",
    {
      "key": "󰣇 OS",
      "keyColor": "blue",
      "type": "os"
    },
    {
      "key": "󰍹 Display",
      "keyColor": "cyan",
      "type": "display"
    },
    {
      "key": "󰌢 Machine",
      "keyColor": "cyan",
      "type": "host"
    },
    {
      "key": " Kernel",
      "keyColor": "blue",
      "type": "kernel"
    },
    {
      "key": " Packages",
      "keyColor": "cyan",
      "type": "packages"
    },
    {
      "key": " WM",
      "keyColor": "blue",
      "type": "wm"
    },
    {
      "key": " Terminal",
      "keyColor": "cyan",
      "type": "terminal"
    },
    {
      "key": " Font",
      "keyColor": "blue",
      "type": "terminalfont"
    },
    {
      "key": "󰻠 CPU",
      "keyColor": "cyan",
      "type": "cpu"
    },
    {
      "key": "󰍛 GPU",
      "keyColor": "blue",
      "type": "gpu"
    },
    {
      "key": "󰑭 Memory",
      "keyColor": "cyan",
      "type": "memory"
    },
    {
      "key": "󰋊 Disk",
      "keyColor": "blue",
      "type": "disk"
    },
    "break",
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 10,
      "symbol": "circle",
      "block": {
        "width": 10
      }
    }
  ]
}
