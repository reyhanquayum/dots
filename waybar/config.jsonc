{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  

  "margin-bottom": 0,
  "spacing": 0,
  "fixed-center": true,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  "modules-left": ["niri/workspaces"],
  "modules-right": [
    "custom/keyboard-layout",
    "memory",
    "cpu",
    "disk",
    "custom/battery",
    "pulseaudio",
    "pulseaudio#microphone",
    "tray"
  ],
  "height": 44,
  "modules-center": ["clock"],
  "clock": {
    "format": "{:%a %b %d  %I:%M %p}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
            "months": "<span color='#ffead3'><b>{}</b></span>",
            "days": "<span color='#ecc6d9'><b>{}</b></span>",
            "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
            "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
        }
    },
    "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
    }
  },
  "niri/workspaces": {
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "〇"
    }
  },
  "cpu": {
    "interval": 1,
    "format": " {usage}%",
    "format-icons": [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "kitty --class system_monitor -e btop",
    "max-lenght": 25,
    "min-length": 6
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 1,
    "on-click": "kitty --class system_monitor -e btop",
    "max-lenght": 25,
    "min-length": 6
  },
  "network": {
    "interface": "eno1",
    "format-wifi": " ",
    "format-disconnected": "  睊  ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "tooltip-format-wifi": "{essid} {signalStrength}%",
    "on-click": "kitty --class network -e nmtui"
  },
  "disk": {
    "interval": 30,
    "format": "󰋊 {percentage_used}%",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "HDD - {used} used out of {total} on {path} ({percentage_used}%)",
    "on-click": "kitty --class system_monitor -e ncdu --color dark"
  },

  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "interval": 5
  },

  "pulseaudio": {
    "format": " {volume}%",
    "format-bluetooth": " {volume}%",
    "format-muted": " {volume}%",
  },
  "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " ",
        "format-source-muted": " ",
        "on-click": "~/.config/hypr/scripts/volume --toggle-mic",
        "on-click-right": "pavucontrol",
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 14,
    "icon-theme": "Papirus",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["Alacritty", "kitty"],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    },
  },
  "custom/keyboard-layout": {
    "exec": "niri msg keyboard-layouts | grep '*' | cut -c 5-",
    "interval": 1,
    "format": " {}",
    "tooltip": false
  },
}
